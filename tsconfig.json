{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",          // Better for ESM + Node.js (stricter path handling)
    "moduleResolution": "NodeNext",
    "lib": ["ESNext"],
    "outDir": "./dist",
    "rootDir": ".",                // ← Change this to "." (current root)
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,          // Optional: Set to false if you don't need .d.ts files
    "declarationMap": false,
    "sourceMap": true,
    "removeComments": true
  },
  "include": ["**/*.ts"],          // ← Compiles ALL .ts files in the project (safest)
  "exclude": ["node_modules", "dist"]
}